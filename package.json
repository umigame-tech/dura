{
  "name": "dura",
  "version": "0.1.0",
  "description": "Shared, durable state for AI agent loops: sections, append-only journal, and notifications.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.js",
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/node.js --jsx=automatic --jsx-import-source=hono/jsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:migrate": "wrangler d1 migrations apply dura --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@simplewebauthn/server": "^13.2.2",
    "better-sqlite3": "^12.4.1",
    "diff": "^8.0.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.4",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
